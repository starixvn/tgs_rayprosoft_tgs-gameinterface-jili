<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Version>0.0.1</Version>
		<Authors>Raypro</Authors>
		<Description>Tgs GameInterface JiliService Client</Description>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-jiliservice</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-jiliservice.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Tgs GameInterface JiliService</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.50.0" />
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.50.0" />
		<PackageReference Include="Grpc.Tools" Version="2.51.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Protos\" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="..\Tgs.GameInterface.JiliService\Protos\gameinterfacejiliservice.proto" GrpcServices="Client">
			<Link>Protos\gameinterfacejiliservice.proto</Link>
		</Protobuf>
	</ItemGroup>

</Project>
