<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net7.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>0.0.2</Version>
		<Authors>Raypro</Authors>
		<RootNamespace>Tgs.GameInterface.Jili.Client</RootNamespace>
		<PackageId>Tgs.GameInterface.Jili.Client</PackageId>
		<Title>Tgs.GameInterface.Jili.Client</Title>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-jiliservice</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gameinterface-jiliservice.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Tgs GameInterface Jili Client</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.52.0" />
		<PackageReference Include="Grpc.Net.ClientFactory" Version="2.52.0" />
		<PackageReference Include="Grpc.Tools" Version="2.53.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.6" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Protos\" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="..\Tgs.GameInterface.JiliService\Protos\gameinterfacejiliservice.proto" GrpcServices="Client">
			<Link>Protos\gameinterfacejiliservice.proto</Link>
		</Protobuf>
	</ItemGroup>

</Project>
